# 2026-07-26 Adapted from https://github.com/jbreer/claude-code-in-apple-container/

FROM node:26-trixie-slim

# Etc/UTC is the canonical format.  Really.
ARG TZ="Etc/UTC"
ARG USERNAME=pineapple

ENV TZ="$TZ" \
  LANG=en_US.UTF-8 \
  LC_ALL=en_US.UTF-8 \
  EDITOR=nvim \
  VISUAL=nvim \
  DEVCONTAINER=true \
  PATH=/home/${USERNAME}/.local/bin:${PATH}

# Debian package installation
RUN << EOF
  /usr/bin/apt-get -qq update 
  /usr/bin/apt-get -qq -y --no-install-recommends install \
    aggregate \
    apt-transport-https \
    bind9-dnsutils \
    ca-certificates \
    curl \
    fd-find \
    git \
    gpg \
    iproute2 \
    ipset \
    iptables \
    jq \
    locales \
    neovim \
    sudo \
    ripgrep \
    rlwrap \
    unzip \
    wget
  /usr/bin/apt-get -qq clean
  /bin/rm -rf /var/lib/apt/lists/*
  /bin/sed -i '/en_US.UTF-8/s/^# //' /etc/locale.gen 
  /usr/sbin/locale-gen
EOF

# to support firewall on run
COPY init-firewall.sh entrypoint.sh /usr/local/bin/

# node:26 ships with a 'node' user/group at UID/GID 1000
# remove user and group and create pineapple with same id's
ARG PI_UID=1000
ARG PI_GID=1000
RUN << EOF 
  userdel --remove node 2>/dev/null
  groupdel node 2>/dev/null
  groupadd --gid ${PI_GID} ${USERNAME}
  useradd --uid ${PI_UID} --gid ${PI_GID} --create-home --shell /bin/bash ${USERNAME}
  mkdir /command-history
  touch /command-history/.bash_history
  chown -R ${USERNAME} /command-history
  mkdir -p /workspace /home/${USERNAME}/.pi 
  chown -R ${USERNAME}:${USERNAME} /workspace /home/${USERNAME}/.pi
  chmod 0555 /usr/local/bin/entrypoint.sh
  chmod 0500 /usr/local/bin/init-firewall.sh
  echo "${USERNAME}  ALL = NOPASSWD: /usr/local/bin/init-firewall.sh" >> /etc/sudoers
EOF

# Install Pi Coding Agent
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent

USER ${USERNAME}
WORKDIR /workspace

CMD ["/usr/local/bin/entrypoint.sh","/usr/local/bin/pi"]
