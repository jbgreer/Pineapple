FROM pineapple-base:latest

# ARG values do not propagate from the base image, so
# redeclare the ones used below
ARG USERNAME=pineapple
ARG MTPLX_HOST=192.168.64.1

# Need to explicitly set to root because of base
USER root

# pi is a rapidly iterating project; refresh the globally
# installed agent before installing any new extensions
RUN << EOF
  /usr/local/bin/pi update
EOF

USER ${USERNAME}

# Update any pi extensions installed in earlier images
# before installing any new extensions
RUN << EOF
  /usr/local/bin/pi update --extensions
EOF

# Install pi package(s)
RUN << EOF
  /usr/local/bin/pi install npm:pi-mtplx
EOF

# Setup authorization for access to mtplx
RUN << EOF
echo "{
  \"mtplx\": {
    \"type\": \"api_key\",
    \"key\": \"mtplx-local\"
  }
}" > /home/${USERNAME}/.pi/agent/auth.json
EOF

# Setup model entry for access to mtplx
RUN << EOF
echo "{
  \"providers\": {
    \"mtplx\": {
      \"api\": \"openai-completions\",
      \"authHeader\": true,
      \"baseUrl\": \"http://${MTPLX_HOST}/v1\",
      \"models\": [
        { \"id\": \"mtplx-qwen38-27b-optimized-speed\" },
        { \"id\": \"mtplx-qwen38-27b-optimized-quality\" },
        { \"id\": \"mtplx-qwen38-35b-a3b-optimized-speed\" }
      ]
    }
  }
}" > /home/${USERNAME}/.pi/agent/models.json
EOF