FROM pineapple-clojure-tools:latest

# ARG values do not propagate from the base image, so
# redeclare the ones used below
ARG USERNAME=pineapple

# pi is a rapidly iterating project; refresh the globally
# installed agent here so rebuilding this leaf image picks up
# the latest pi without rebuilding the earlier images
USER root
RUN /usr/local/bin/pi update

USER ${USERNAME}

# Update any pi extensions installed in earlier images
# before installing any new extensions
RUN /usr/local/bin/pi update --extensions

# Install pi package(s)
RUN /usr/local/bin/pi install npm:pi-local-models