# 2026-07-26 Adapted from https://github.com/jbreer/claude-code-in-apple-container/

FROM pineapple-base:latest

ARG USERNAME=pineapple

# Need to explicitly set to root because of base
USER root

# Install Rust. Required for parinfer-rust.
RUN << EOF
  /usr/bin/apt-get -qq update 
  /usr/bin/apt-get -qq -y --no-install-recommends install \
    cargo \
    ssh
EOF

# Install Temurin 25 JDK
RUN << EOF
  wget -qO - https://packages.adoptium.net/artifactory/api/gpg/key/public | gpg --dearmor | tee /etc/apt/trusted.gpg.d/adoptium.gpg > /dev/null
  echo "deb https://packages.adoptium.net/artifactory/deb $(awk -F= '/^VERSION_CODENAME/{print$2}' /etc/os-release) main" | tee /etc/apt/sources.list.d/adoptium.list 
  /usr/bin/apt-get -qq update 
  /usr/bin/apt-get -qq -y --no-install-recommends install temurin-25-jdk
EOF

# switch to local user installs
USER ${USERNAME}
WORKDIR /home/${USERNAME}

# Install clojure
RUN << EOF
  curl -sLO https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh
  chmod +x linux-install.sh
  ./linux-install.sh --prefix /home/${USERNAME}/.local
  rm -r linux-install.sh
EOF

# Install clj-lsp
RUN  << EOF
  curl -sLO https://raw.githubusercontent.com/clojure-lsp/clojure-lsp/master/install
  /bin/chmod +x ./install
  ./install --dir /home/${USERNAME}/.local/bin
  rm -f install
EOF

# Install clj-kondo
RUN << EOF
  /usr/bin/curl -sLO https://raw.githubusercontent.com/clj-kondo/clj-kondo/master/script/install-clj-kondo
  /bin/chmod +x install-clj-kondo
  ./install-clj-kondo --dir /home/${USERNAME}/.local/bin
  rm -f install-clj-kondo
EOF

# Install babashka
RUN << EOF
  /usr/bin/curl -sLO https://raw.githubusercontent.com/babashka/babashka/master/install
  /bin/chmod +x ./install
  ./install --dir /home/${USERNAME}/.local/bin
  rm -f install
EOF

# Install bbin
RUN << EOF
  /usr/bin/curl -sLO https://raw.githubusercontent.com/babashka/bbin/v0.2.5/bbin
  mv bbin /home/${USERNAME}/.local/bin/bbin
  chmod +x /home/${USERNAME}/.local/bin/bbin
EOF

# Install clojure-mcp-light
RUN << EOF
  bbin install https://github.com/bhauman/clojure-mcp-light.git --tag v0.2.2
  bbin install https://github.com/bhauman/clojure-mcp-light.git --tag v0.2.2 --as clj-nrepl-eval --main-opts '["-m" "clojure-mcp-light.nrepl-eval"]'
  bbin install https://github.com/bhauman/clojure-mcp-light.git --tag v0.2.2 --as clj-paren-repair --main-opts '["-m" "clojure-mcp-light.paren-repair"]'
EOF

# Install parinfer-rust
RUN << EOF
  git clone https://github.com/eraserhd/parinfer-rust.git
  cd parinfer-rust
  cargo build --release
  cargo install --path . --root /home/${USERNAME}/.local
  cd ..
  rm -rf parinfer-rust
EOF

# Install cljfmt 
RUN << EOF
  clj -Ttools install io.github.weavejester/cljfmt '{:git/tag "0.16.5"}' :as cljfmt
EOF

WORKDIR /workspace

#CMD ["/usr/local/bin/entrypoint.sh","/usr/bin/bash"]
CMD ["/usr/local/bin/entrypoint.sh","/usr/local/bin/pi"]
